APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SANCTUM_TOKEN_EXPIRATION=43200 # Maximum token age in minutes; login sessions have shorter per-token expiries.
AI_PROMPT_VERSION=v1
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoreply
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Database backups are application-encrypted before storage. Prefer a private
# remote disk in production; the local default is private under storage/app/private.
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=7
QUEUE_CONNECTION=database
OPERATIONS_ALERT_EMAIL=
QUEUE_BACKLOG_ALERT_THRESHOLD=1000
FAILED_JOB_ALERT_THRESHOLD=1
SEND_FAILURE_RATE_ALERT_PERCENT=20
SEND_FAILURE_RATE_MIN_SAMPLE=10
WEBHOOK_SIGNATURE_FAILURE_ALERT_THRESHOLD=5
OPERATIONS_ALERT_DEDUP_MINUTES=60

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative: Claude (disabled for now)
# ANTHROPIC_API_KEY=

# Paymob Payment Gateway
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_KEY=
PAYMOB_CURRENCY=EGP

# Set true only after MyFatoorah activates managed recurring payments for this account.
MYFATOORAH_RECURRING_ENABLED=false


# Evolution API (WhatsApp)
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_TIMEOUT=30
EVOLUTION_MAX_RETRIES=3

# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Google (Gmail/Reviews/Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Pusher (Real-time)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
PUSHER_HOST=

# Blog Approval Webhook
BLOG_APPROVAL_SECRET=

# Salla E-commerce Integration
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
SALLA_REDIRECT_URI=
SALLA_API_BASE_URL=https://api.salla.dev

# Telegram Integration
TELEGRAM_BOT_TOKEN=

# TikTok Integration
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.nazbiz.io/api/channels/callback/tiktok

# Shopify Integration
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://api.nazbiz.io/api/channels/callback/shopify
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_customers,write_orders,write_customers,write_webhooks
SHOPIFY_USE_LEGACY_INSTALL_FLOW=true
SHOPIFY_API_VERSION=2026-07

# Agent routing: opt in to fail-closed behavior for channels without an active agent.
AGENT_ROUTING_FAIL_CLOSED=false
HANDOFF_EMAIL_NOTIFICATIONS=true
HANDOFF_SLA_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
