        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { message: $json.message, platform: $json.platform, conversation_id: $json.conversation_id, user_id: $json.user_id, business_id: $json.business_id, language: $json.detected_language, memory: $json.conversation_memory, intent: $json.detected_intent, order_data: $json.order_data || null, knowledge_base: $json.knowledge_base || '' } }}",
        "options": {
