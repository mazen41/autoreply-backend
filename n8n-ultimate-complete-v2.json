    {
      "parameters": {
        "jsCode": "// Intent Classification Logic\nconst message = $input.item.json.message.toLowerCase();\nconst platform = $input.item.json.platform;\n\n// Order-related keywords\nconst orderKeywords = ['order', 'طلب', 'tracking', 'حالة', 'status', 'delivery', 'توصيل', 'shipping', 'شحن', 'فين', 'سعر', 'price'];\n\n// Greeting keywords\nconst greetingKeywords = ['hi', 'hello', 'hey', 'السلام', 'مرحبا', 'أهلا', 'هاي', 'good morning', 'good evening', 'صباح', 'مساء'];\n\nlet intent = 'question';\nlet confidence = 0.7;\n\n// Check for order intent\nfor (const keyword of orderKeywords) {\n  if (message.includes(keyword)) {\n    intent = 'order';\n    confidence = 0.85;\n    break;\n  }\n}\n\n// Check for greeting intent\nfor (const keyword of greetingKeywords) {\n  if (message.includes(keyword)) {\n    intent = 'greeting';\n    confidence = 0.95;\n    break;\n  }\n}\n\nreturn {\n  json: {\n    ...$input.item.json,\n    detected_intent: intent,\n    intent_confidence: confidence\n  }\n};"
      },
      "id": "intent-classification",
      "name": "🎯 Intent Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.detected_intent }}",
                    "rightValue": "order",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "order_request"
            },
            {
