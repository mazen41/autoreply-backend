      "id": "ultimate-ai-call",
      "name": "🧠 Ultimate AI Call (JSON Output)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2800, 400],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// JSON Response Parsing Logic\nconst aiResponse = $input.item.json;\n\ntry {\n  const parsed = {\n    success: aiResponse.success || false,\n    reply: aiResponse.reply || '',\n    intent: aiResponse.intent || 'unknown',\n    needs_escalation: aiResponse.needs_escalation || false,\n    confidence: aiResponse.confidence || 0.5,\n    validation: aiResponse.validation || { valid: true, reasons: [] }\n  };\n  \n  return {\n    json: {\n      ...$input.item.json,\n      ai_parsed: parsed\n    }\n  };\n} catch (error) {\n  return {\n    json: {\n      ...$input.item.json,\n      ai_parsed: {\n        success: false,\n        reply: \"I apologize, but I'm having trouble processing your request.\",\n        intent: 'escalation',\n        needs_escalation: true,\n        confidence: 0.5,\n        validation: { valid: false, reasons: ['parse_error'] }\n      }\n    }\n  };\n}"
      },
      "id": "json-parsing",
      "name": "📊 JSON Response Parsing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3000, 400]
    },
    {
      "parameters": {
        "jsCode": "// Response Validation Logic\nconst aiResult = $input.item.json.ai_parsed;\nconst intent = aiResult.intent;\nconst reply = aiResult.reply;\n\nconst validation = {\n  valid: true,\n  reasons: [],\n  warnings: []\n};\n\n// Rule 1: Empty response\nif (!reply || reply.trim().length === 0) {\n  validation.valid = false;\n  validation.reasons.push('empty_response');\n}\n\n// Rule 2: Too long\nif (reply.length > 500) {\n  validation.valid = false;\n  validation.reasons.push('too_long');\n  validation.warnings.push(`Response length: ${reply.length} chars`);\n}\n\n// Rule 3: Uncertain language\nconst uncertainPhrases = ['i think', 'maybe', 'possibly', 'might be', 'ربما', 'قد يكون', 'أعتقد'];\nconst lowerReply = reply.toLowerCase();\nfor (const phrase of uncertainPhrases) {\n  if (lowerReply.includes(phrase)) {\n    validation.valid = false;\n    validation.reasons.push('uncertain_language');\n    break;\n  }\n}\n\n// Rule 4: System instruction leakage\nconst systemKeywords = ['system prompt', 'instructions', 'rules', 'ai assistant', 'as an ai'];\nfor (const keyword of systemKeywords) {\n  if (lowerReply.includes(keyword)) {\n    validation.valid = false;\n    validation.reasons.push('system_instruction_leak');\n    break;\n  }\n}\n\n// Rule 5: JSON/Code leakage\nif (reply.includes('{') || reply.includes('}') || reply.includes('```')) {\n  validation.valid = false;\n  validation.reasons.push('contains_code_or_json');\n}\n\n// Rule 6: Greeting length check\nif (intent === 'greeting' && reply.length > 100) {\n  validation.valid = false;\n  validation.reasons.push('greeting_too_long');\n}\n\nreturn {\n  json: {\n    ...$input.item.json,\n    ai_result: aiResult,\n    validation: validation\n  }\n};"
      },
