{
  "name": "Ultimate AI Customer Support System",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "ultimate-ai-support"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "platform-detection",
              "name": "platform",
              "value": "={{ $json.body.platform }}",
              "type": "string"
            },
            {
              "id": "message-extract",
              "name": "message",
              "value": "={{ $json.body.message }}",
              "type": "string"
            },
            {
              "id": "sender-extract",
              "name": "sender_id",
              "value": "={{ $json.body.sender_id }}",
              "type": "string"
            },
            {
              "id": "conversation-extract",
              "name": "conversation_id",
              "value": "={{ $json.body.conversation_id }}",
              "type": "string"
            },
            {
              "id": "user-extract",
              "name": "user_id",
              "value": "={{ $json.body.user_id }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "parse-webhook",
      "name": "Parse Webhook Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "lowercase-message",
              "name": "message_lower",
              "value": "={{ $json.message.toLowerCase() }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "lowercase-message",
      "name": "Lowercase Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "escalation-keyword-1",
              "leftValue": "={{ $json.message_lower }}",
              "rightValue": "human",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "escalation-keyword-2",
              "leftValue": "={{ $json.message_lower }}",
              "rightValue": "agent",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "escalation-keyword-3",
              "leftValue": "={{ $json.message_lower }}",
              "rightValue": "support",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "escalation-keyword-4",
              "leftValue": "={{ $json.message_lower }}",
              "rightValue": "موظف",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "escalation-keyword-5",
              "leftValue": "={{ $json.message_lower }}",
              "rightValue": "انسان",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "any"
        }
      },
      "id": "hard-escalation-check",
      "name": "Hard Escalation Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.nazbiz.io/api/escalate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { conversation_id: $json.conversation_id, reason: 'hard_keyword_override', priority: 'high' } }}",
        "options": {}
      },
      "id": "immediate-escalation",
      "name": "Immediate Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "api-auth",
          "name": "API Auth"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, message: 'Escalation triggered', requires_human: true } }}"
      },
      "id": "escalation-response",
      "name": "Escalation Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.nazbiz.io/api/ai/process",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { message: $json.message, platform: $json.platform, conversation_id: $json.conversation_id, user_id: $json.user_id } }}",
        "options": {}
      },
      "id": "call-laravel-ai",
      "name": "Call Laravel AI System",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "api-auth",
          "name": "API Auth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ai-success-check",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ai-success-check",
      "name": "AI Success Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "send-ai-response",
      "name": "Send AI Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, message: 'AI processing failed', requires_human: true } }}"
      },
      "id": "ai-fallback-response",
      "name": "AI Fallback Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1450, 500]
    }
  ],
